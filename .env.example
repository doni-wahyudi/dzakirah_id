# Supabase public client config (safe to expose in the browser — protect with RLS).
# Copy this file to .env.local for local development.
# For CI/GitHub Pages, set these as repository secrets and expose them in the workflow.

VITE_SUPABASE_URL=https://qtagroahdshxasyupotw.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Set to "true" to force the app to use Supabase only (no static fallback).
# Leave false/empty in production so the site stays up if the API is unreachable.
VITE_SUPABASE_STRICT=false
